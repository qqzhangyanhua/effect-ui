{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/lib/text-style": ["../../packages/registry/src/lib/text-style.ts"],
      "@/components/ui/*": [
        "../../packages/registry/src/ui/*",
        "../../packages/registry/src/effects/*",
        "../../packages/registry/src/sections/*"
      ],
      "@/hooks/*": ["../../packages/registry/src/hooks/*"],
      "@effect-ui/registry/*": ["../../packages/registry/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/registry/src/**/*.ts",
    "../../packages/registry/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "../../packages/registry/src/**/*.test.ts", "../../packages/registry/src/**/*.test.tsx"]
}
