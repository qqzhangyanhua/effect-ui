{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/components/ui/*": ["../../packages/registry/src/ui/*"],
      "@/hooks/*": ["../../packages/registry/src/hooks/*"],
      "@effect-ui/registry/*": ["../../packages/registry/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/registry/src/**/*.ts",
    "../../packages/registry/src/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
